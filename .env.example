# Database
NUXT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dartscounter

# Better Auth
BETTER_AUTH_SECRET=better-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# Turnstile
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA # Always passes validation Test successful token validation
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000AB # Always fails Visible Test error handling and retry logic
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB # Always passes Invisible Test invisible widget success flows
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000BB # Always fails Invisible Test invisible widget error handling
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=3x00000000000000000000FF # Forces interactive challenge Visible Test user interaction scenarios
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA # Always passes validation Test successful token validation
# NUXT_TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA # Always fails validation Test validation error handling
# NUXT_TURNSTILE_SECRET_KEY=3x0000000000000000000000000000000AA # Returns "token already spent" error Test duplicate token handling

# Resend
NUXT_RESEND_API_KEY=re_send-api-key
# Required: use a sender on your verified Resend domain
NUXT_RESEND_FROM="DartsCounter <no-reply@dartscounter.christophecvb.com>"

# Request Logging
REQUEST_LOGGING_ENABLED=true
