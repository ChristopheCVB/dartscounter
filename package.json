{
  "name": "dartscounter",
  "type": "module",
  "private": false,
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev",
    "generate": "bun --bun nuxt generate",
    "preview": "bun --bun nuxt preview",
    "test": "bun --bun vitest run --pool=threads",
    "test:watch": "bun --bun vitest --pool=threads",
    "postinstall": "bun --bun nuxt prepare",
    "typecheck": "bun --bun nuxt typecheck",
    "start": "bun .output/server/index.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@pinia/nuxt": "^1.0.3",
    "@vueuse/nuxt": "^15.0.0",
    "@vueuse/sound": "^2.1.3",
    "canvas-confetti": "^1.9.4",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "@vue/test-utils": "^2.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
