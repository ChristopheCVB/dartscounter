{
  "name": "dartscounter",
  "version": "2.0.0",
  "type": "module",
  "private": false,
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev",
    "generate": "bun --bun nuxt generate",
    "preview": "bun --bun nuxt preview",
    "test": "bun --bun vitest run --pool=threads",
    "test:watch": "bun --bun vitest --pool=threads",
    "test:unit": "bun --bun vitest run --project unit",
    "test:nuxt": "bun --bun vitest run --project nuxt",
    "test:e2e": "bun --bun vitest run --project e2e",
    "test:integration": "bun --bun vitest run --project integration",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "postinstall": "bun --bun nuxt prepare",
    "pwa-assets:generate": "pwa-assets-generator",
    "typecheck": "BUN_OPTIONS=--preload=./scripts/vue-tsc-bun.cjs bun --bun nuxt typecheck",
    "start": "bun .output/server/index.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/turnstile": "^1.1.3",
    "@pinia/nuxt": "^1.0.3",
    "@vueuse/nuxt": "^15.0.0",
    "@vueuse/sound": "^2.1.3",
    "better-auth": "^1.7.12",
    "canvas-confetti": "^1.9.4",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.2",
    "nuxt-email-renderer": "^2.11.2",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "resend": "^6.34.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/pg": "^8.23.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
